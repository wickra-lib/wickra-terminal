{
  "name": "wickra-terminal-web",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "description": "The Web renderer of the Wickra trading terminal: a Vue front-end over the WASM binding, sharing the core's view-models with the native TUI.",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "vue-tsc --noEmit",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "wickra-terminal-wasm": "file:../bindings/wasm/pkg"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
