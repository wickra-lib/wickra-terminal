/target
# cargo-fuzz builds in a detached workspace under fuzz/; its build dir and
# resolved lockfile are local artifacts, never committed.
/fuzz/target
/fuzz/Cargo.lock
**/*.rs.bk
Cargo.lock.bak
.DS_Store
.idea/
.vscode/
*.pdb

# Python build artifacts
__pycache__/
.pytest_cache/
*.py[cod]
*.so
*.pyd
*.egg-info/
dist/
.venv/
build/

# Node build artifacts (index.js / index.d.ts ARE committed)
node_modules/
*.node

# WASM / web build artifacts
bindings/wasm/pkg/
# The nodejs-target build the WASM test suite requires (CI builds both targets:
# `web` for the renderer, `nodejs` so `require()` can load the module).
bindings/wasm/pkg-node/
web/node_modules/
web/dist/

# Go: the C ABI library is staged per-platform by CI, never committed here.
bindings/go/lib/*/

# .NET build artifacts, scoped rather than bare. A repository-wide `bin/` also
# matches Cargo's `src/bin/` convention, and it did: examples/rust/src/bin was
# invisible to `git add`, so the no-boundary benchmark would have been left out
# of its own commit and CI would have failed on a bin target that was never
# committed. Every real .NET output tree is under one of these two roots.
bindings/csharp/**/bin/
bindings/csharp/**/obj/
examples/csharp/bin/
examples/csharp/obj/

# Java / Maven build artifacts
bindings/java/target/

# R build artifacts
# Written by the wheel container-smoke job at run time.
wheel-smoke.py

bindings/r/.rlib/
bindings/r/src/*.o
bindings/r/src/*.so
bindings/r/src/*.dll
bindings/r/src/*.dylib
bindings/r/..Rcheck/
# Written by configure / configure.win at install time from Makevars.in, and the
# C ABI it stages in beside them. None of it belongs in the tree: the tracked
# file is the template, and a stale generated Makevars would silently override
# it on the next build.
bindings/r/src/Makevars
bindings/r/src/Makevars.win
bindings/r/src/wickra_terminal.h
bindings/r/src/wickra-terminal-c/
bindings/r/src/wickra-terminal-c.tar.gz

# Local secrets — exchange API keys must never be committed.
.env
.env.*
*.key
secrets/

# Coverage and benchmark output. ci.yml writes lcov.info at the repo root and
# bench.yml writes benchmark.txt there; both are run artifacts, not sources.
*.profraw
lcov.info
tarpaulin-report.html
criterion/
benchmark.txt

# Benchmark build trees. The C and C++ harnesses configure CMake in place, and
# the C# one is an ordinary dotnet project.
bindings/*/benchmarks/build/
bindings/*/benchmarks/bin/
bindings/*/benchmarks/obj/
