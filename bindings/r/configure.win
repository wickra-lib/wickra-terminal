#!/bin/sh
# Resolve the wickra-terminal C ABI for the Windows build.
#
# Simpler than the equivalent in the wickra library, and worth saying why: there
# the package compiles to wickra.dll and the C ABI is also wickra.dll, so the
# loader would resolve the import to the package itself and that build has to
# stage a renamed copy and synthesise an import library with dlltool. Here the
# package is wickraterminal.dll and the C ABI is wickra_terminal.dll, which do
# not collide, so mingw can link the DLL directly.
#
# Self-contained by default: download the prebuilt
# wickra-terminal-c-<triple>.tar.gz release asset matching this package's
# version. Set WKTERM_INC + WKTERM_LIB to build against a locally built C ABI
# instead (dev override; e.g. `cargo build -p wickra-terminal-c --release`).
set -e

inc=""
lib=""

wkterm_download() {
  _url="$1"
  _dest="$2"
  _attempt=1
  while [ "${_attempt}" -le 6 ]; do
    if "${R_HOME}/bin/Rscript" -e "download.file('${_url}', '${_dest}', mode = 'wb', quiet = TRUE)"; then
      return 0
    fi
    echo "wickraterminal: download attempt ${_attempt}/6 failed (${_url}); the release asset may still be propagating - retrying in 20s..."
    sleep 20
    _attempt=$((_attempt + 1))
  done
  echo "wickraterminal: failed to download ${_url} after 6 attempts"
  return 1
}

if [ -n "${WKTERM_INC}" ] && [ -n "${WKTERM_LIB}" ]; then
  echo "wickraterminal: using C ABI from WKTERM_INC / WKTERM_LIB (dev override)"
  inc="${WKTERM_INC}"
  lib="${WKTERM_LIB}"
else
  version=$(sed -n 's/^Version:[[:space:]]*//p' DESCRIPTION)
  # R_ARCH is /x64 on 64-bit Windows and /arm64 on the aarch64 build.
  case "${R_ARCH}" in
    *arm64*) triple="aarch64-pc-windows-msvc" ;;
    *) triple="x86_64-pc-windows-msvc" ;;
  esac
  url="https://github.com/wickra-lib/wickra-terminal/releases/download/v${version}/wickra-terminal-c-${triple}.tar.gz"
  echo "wickraterminal: downloading C ABI ${triple} for v${version}"
  wkterm_download "${url}" "src/wickra-terminal-c.tar.gz" || exit 1
  "${R_HOME}/bin/Rscript" -e "untar('src/wickra-terminal-c.tar.gz', exdir = 'src/wickra-terminal-c')"
  inc="src/wickra-terminal-c/wickra-terminal-c-${triple}/include"
  lib="src/wickra-terminal-c/wickra-terminal-c-${triple}/lib"
fi

cp "${inc}/wickra_terminal.h" src/wickra_terminal.h
if [ ! -f "${lib}/wickra_terminal.dll" ]; then
  echo "wickraterminal: no wickra_terminal.dll found under ${lib}"
  exit 1
fi
cp "${lib}/wickra_terminal.dll" src/wickra_terminal.dll

# The bundled DLL sits beside the package object in libs/<arch>, and .onLoad
# adds that directory to PATH before dyn.load, which is how Windows resolves it.
cat > src/Makevars.win <<'EOF'
# Generated by ../configure.win. The C ABI header and DLL are staged into src/,
# so the include path is the source directory and the DLL is linked directly --
# the package object is wickraterminal.dll, which does not collide with it.
PKG_CPPFLAGS = -I.
PKG_LIBS = -L. -l:wickra_terminal.dll
EOF

echo "wickraterminal: configured (bundled wickra_terminal.dll)"
exit 0
