#!/bin/sh
# Resolve the wickra-terminal C ABI (header + shared library) for the Unix build.
#
# Self-contained by default: download the prebuilt wickra-terminal-c-<triple>.tar.gz
# release asset that matches this package's version and stage the shared library
# into src/, so the compiled object links against it and bundles it (via
# install.libs.R), found post-install through an rpath ($ORIGIN on Linux,
# @loader_path on macOS).
#
# Set WKTERM_INC + WKTERM_LIB to build against a locally built C ABI instead
# (dev override; e.g. `cargo build -p wickra-terminal-c --release`). That path
# was the ONLY one before this script existed, which is why the package could
# not be installed from r-universe: a clean build container sets neither.
#
# Download and extraction use base R, which is always present at build time, so
# there is no curl/wget system dependency.
set -e

inc=""
lib=""

# A freshly-cut GitHub release can briefly return 404 while its assets propagate
# across the CDN, and a transient network blip should not fail the build either.
# Retry base R's download.file with a backoff (~2 min total) rather than giving
# up on the first miss.
wkterm_download() {
  _url="$1"
  _dest="$2"
  _attempt=1
  while [ "${_attempt}" -le 6 ]; do
    if "${R_HOME}/bin/Rscript" -e "download.file('${_url}', '${_dest}', mode = 'wb', quiet = TRUE)"; then
      return 0
    fi
    echo "wickraterminal: download attempt ${_attempt}/6 failed (${_url}); the release asset may still be propagating - retrying in 20s..."
    sleep 20
    _attempt=$((_attempt + 1))
  done
  echo "wickraterminal: failed to download ${_url} after 6 attempts"
  return 1
}

if [ -n "${WKTERM_INC}" ] && [ -n "${WKTERM_LIB}" ]; then
  echo "wickraterminal: using C ABI from WKTERM_INC / WKTERM_LIB (dev override)"
  inc="${WKTERM_INC}"
  lib="${WKTERM_LIB}"
else
  version=$(sed -n 's/^Version:[[:space:]]*//p' DESCRIPTION)
  os=$(uname -s)
  arch=$(uname -m)
  case "${os}" in
    Linux)
      case "${arch}" in
        x86_64) triple="x86_64-unknown-linux-gnu" ;;
        aarch64 | arm64) triple="aarch64-unknown-linux-gnu" ;;
        *) echo "wickraterminal: unsupported Linux arch '${arch}' - set WKTERM_INC/WKTERM_LIB"; exit 1 ;;
      esac
      ;;
    Darwin)
      case "${arch}" in
        x86_64) triple="x86_64-apple-darwin" ;;
        arm64 | aarch64) triple="aarch64-apple-darwin" ;;
        *) echo "wickraterminal: unsupported macOS arch '${arch}' - set WKTERM_INC/WKTERM_LIB"; exit 1 ;;
      esac
      ;;
    *)
      echo "wickraterminal: unsupported OS '${os}' - set WKTERM_INC/WKTERM_LIB"
      exit 1
      ;;
  esac
  url="https://github.com/wickra-lib/wickra-terminal/releases/download/v${version}/wickra-terminal-c-${triple}.tar.gz"
  echo "wickraterminal: downloading C ABI ${triple} for v${version}"
  wkterm_download "${url}" "src/wickra-terminal-c.tar.gz" || exit 1
  "${R_HOME}/bin/Rscript" -e "untar('src/wickra-terminal-c.tar.gz', exdir = 'src/wickra-terminal-c')"
  inc="src/wickra-terminal-c/wickra-terminal-c-${triple}/include"
  lib="src/wickra-terminal-c/wickra-terminal-c-${triple}/lib"
fi

# Stage the header and the platform shared library into src/ so the package
# object links with -L. -lwickra_terminal and install.libs.R bundles the lib.
cp "${inc}/wickra_terminal.h" src/wickra_terminal.h
staged=""
for f in libwickra_terminal.so libwickra_terminal.dylib; do
  if [ -f "${lib}/${f}" ]; then
    cp "${lib}/${f}" "src/${f}"
    staged="${f}"
  fi
done
if [ -z "${staged}" ]; then
  echo "wickraterminal: no libwickra_terminal.so/.dylib found under ${lib}"
  exit 1
fi

# rpath, so the bundled library is found next to the package object after
# install rather than needing LD_LIBRARY_PATH set by whoever runs R.
case "$(uname -s)" in
  Darwin)
    rpath="-Wl,-rpath,@loader_path"
    # Normalise the dylib id to @rpath so @loader_path resolution applies.
    install_name_tool -id "@rpath/${staged}" "src/${staged}" 2>/dev/null || true
    ;;
  *)
    rpath="-Wl,-rpath,'\$\$ORIGIN'"
    ;;
esac

sed "s|@WKTERM_RPATH@|${rpath}|" src/Makevars.in > src/Makevars
echo "wickraterminal: configured (bundled ${staged})"
exit 0
