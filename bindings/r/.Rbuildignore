# Keep compiled artifacts out of the R source tarball built by `R CMD build`.
# The package links the C ABI out-of-tree, so only the glue objects and any
# locally built shared library live under src/ — none of them belong in a
# distributable source package; they are produced at install.
^src/.*\.o$
^src/.*\.so$
^src/.*\.dll$
^src/.*\.dylib$
^src/symbols\.rds$
^\.gitignore$

# The golden corpus lives at the repository root, outside this package, so
# tests/golden.R only resolves when run from there -- which CI does explicitly.
# `R CMD check` runs everything under tests/ from the built tarball, where the
# corpus does not exist, and that is what r-universe runs on every platform.
# `golden_dir()` stops rather than returning NULL, so shipping this file would
# fail every platform build the way wickraexchange 0.1.1 did: 0 of 13.
^tests/golden\.R$
